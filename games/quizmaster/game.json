{
  "id": "quizmaster",
  "title": "QuizMaster",
  "tagline": "Think fast. Play smart.",
  "description": "A quiz game with 400 questions across Science, Geography, Maths and Technology. Pick a topic and a difficulty, beat the countdown, and see how you rank on the weekly, monthly, yearly and lifetime leaderboards. Players can also write their own questions for everyone.",
  "category": "Quiz",
  "tags": ["Quiz", "Leaderboard", "Solo", "Online"],
  "players": "1 player, online leaderboard",
  "features": [
    "400 questions with easy, medium and hard levels",
    "Countdown timer and instant feedback",
    "Weekly, monthly, yearly and lifetime leaderboards",
    "Create your own questions, shared with every player"
  ],
  "accent": "#5b4bff",
  "cover": "docs/assets/screenshot-landing.png",
  "source": "https://github.com/babatundeawo/quizmaster",
  "build": {
    "command": "python3 scripts/build_site.py",
    "output": "dist",
    "env": {
      "SITE_URL": "{site}",
      "FIREBASE_API_KEY": "$FIREBASE_API_KEY",
      "FIREBASE_AUTH_DOMAIN": "$FIREBASE_AUTH_DOMAIN",
      "FIREBASE_PROJECT_ID": "$FIREBASE_PROJECT_ID",
      "FIREBASE_STORAGE_BUCKET": "$FIREBASE_STORAGE_BUCKET",
      "FIREBASE_MESSAGING_SENDER_ID": "$FIREBASE_MESSAGING_SENDER_ID",
      "FIREBASE_APP_ID": "$FIREBASE_APP_ID"
    },
    "previewEnv": {
      "FIREBASE_API_KEY": "ci-check",
      "FIREBASE_AUTH_DOMAIN": "ci-check.firebaseapp.com",
      "FIREBASE_PROJECT_ID": "ci-check",
      "FIREBASE_STORAGE_BUCKET": "ci-check.firebasestorage.app",
      "FIREBASE_MESSAGING_SENDER_ID": "0",
      "FIREBASE_APP_ID": "ci-check"
    },
    "checks": ["python3 scripts/check_site.py dist"]
  }
}
